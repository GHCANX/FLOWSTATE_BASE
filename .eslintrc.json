{
  "env": {
    "node": true,
    "es2024": true,
    "browser": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "error",
    "no-constant-condition": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }]
  },
  "ignorePatterns": [
    "external/",
    "node_modules/",
    "temp_slp/",
    "payloads/",
    "*.db*",
    "test_payloads/"
  ]
}
