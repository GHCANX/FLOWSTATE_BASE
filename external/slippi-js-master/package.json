{
  "name": "@slippi/slippi-js",
  "version": "9.1.3",
  "type": "module",
  "description": "Official Project Slippi Javascript SDK",
  "sideEffects": false,
  "license": "LGPL-3.0-or-later",
  "repository": "project-slippi/slippi-js",
  "author": {
    "name": "Jas Laferriere",
    "email": "jas.laferriere@gmail.com",
    "url": "https://github.com/JLaferri"
  },
  "files": [
    "node",
    "dist"
  ],
  "main": "./dist/browser/index.cjs",
  "module": "./dist/browser/index.esm.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/browser/index.esm.js",
      "require": "./dist/browser/index.cjs",
      "default": "./dist/browser/index.esm.js"
    },
    "./node": {
      "types": "./dist/index.node.d.ts",
      "import": "./dist/node/index.esm.js",
      "require": "./dist/node/index.cjs",
      "default": "./dist/node/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "node": [
        "./dist/index.node.d.ts"
      ]
    }
  },

  "keywords": [
    "slippi-js",
    "slp-parser-js",
    "slp",
    "slippi",
    "melee",
    "ssbm"
  ],
  "dependencies": {
    "@shelacek/ubjson": "^1.0.1",
    "date-fns": "^3.3.0",
    "enet": "^0.2.9",
    "iconv-cp932": "^1.2.2",
    "reconnect-core": "^1.3.0",
    "semver": "^7.3.2"
  },
  "optionalDependencies": {
    "ws": ">=7.0.0"
  }
}
